{
  "name": "skill-registry",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:worker": "npm run dev -w apps/worker",
    "validate:skills": "tsx scripts/validate-skills.ts",
    "build:registry": "tsx scripts/build-registry.ts",
    "pack:skills": "tsx scripts/pack-skills.ts",
    "import:registry": "tsx scripts/import-registry.ts",
    "publish:r2": "tsx scripts/publish-r2.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.11.1"
}
